{
  "name": "tcg-decklab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cards:sync": "tsx scripts/sync-card-data.ts",
    "cards:build": "tsx scripts/build-card-catalogue.ts",
    "cards:validate": "tsx scripts/validate-card-data.ts",
    "cards:report": "tsx scripts/report-missing-effects.ts",
    "abilities:report": "tsx scripts/report-abilities.ts",
    "attacks:report": "tsx scripts/report-attacks.ts",
    "effects:report": "tsx scripts/report-effects.ts",
    "coverage:plan": "tsx scripts/coverage-plan.ts",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "decks:sync": "tsx scripts/deck-sources/sync-deck-corpus.ts",
    "decks:validate": "tsx scripts/deck-sources/validate-deck-corpus.ts",
    "decks:report": "tsx scripts/deck-sources/report-deck-corpus.ts",
    "decks:coverage-plan": "tsx scripts/deck-sources/deck-coverage-plan.ts",
    "decks:rebuild": "tsx scripts/deck-sources/rebuild-checked-in-corpus.ts",
    "decks:matrices": "tsx scripts/report-tournament-matrices.ts",
    "engines:report": "tsx scripts/report-engines.ts",
    "synergies:report": "tsx scripts/report-synergies.ts",
    "acceptance:coverage-wave-1": "tsx scripts/verify-coverage-wave-1.ts",
    "acceptance:team-rocket": "tsx scripts/verify-team-rocket-acceptance.ts",
    "acceptance:deck-architect": "tsx scripts/verify-deck-architect.ts",
    "acceptance:meta-decks": "tsx scripts/acceptance-meta-decks.ts"
    ,"acceptance:rocket-mewtwo": "tsx scripts/acceptance-tournament-runtime.ts rocket-mewtwo"
    ,"acceptance:dragapult": "tsx scripts/acceptance-tournament-runtime.ts dragapult"
    ,"acceptance:ns-zoroark": "tsx scripts/acceptance-tournament-runtime.ts ns-zoroark"
    ,"acceptance:hydrapple": "tsx scripts/acceptance-tournament-runtime.ts hydrapple"
    ,"acceptance:ogerpon-box": "tsx scripts/acceptance-tournament-runtime.ts ogerpon-box"
    ,"acceptance:tournament-runtime-wave-1": "npm run acceptance:rocket-mewtwo && npm run acceptance:dragapult && npm run acceptance:ns-zoroark && npm run acceptance:hydrapple && npm run acceptance:ogerpon-box"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tsx": "^4.23.1",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
